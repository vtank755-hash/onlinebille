<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="vivektank1.AdminMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Admin Panel - Online Billing System</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/Content/Billing.css" rel="stylesheet" type="text/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body class="admin-body">
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <%-- ================= HEADER - shown only on the Admin Login page ================= --%>
        <asp:Panel ID="pnlHeader" runat="server" CssClass="admin-header">
            <div class="admin-header-inner">
                <a id="lnkHome" class="admin-brand" runat="server" href="~/Admin/AdminLogin.aspx" title="Admin Panel - Online Billing System">
                    <span class="admin-brand-logo">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                            <rect x="5.5" y="2.5" width="13" height="19" rx="2.4" fill="#FFFFFF" />
                            <rect x="8.4" y="6.6" width="7.2" height="1.6" rx="0.8" fill="#C2185B" />
                            <rect x="8.4" y="10.3" width="7.2" height="1.6" rx="0.8" fill="#C2185B" />
                            <rect x="8.4" y="14" width="4.6" height="1.6" rx="0.8" fill="#C2185B" />
                            <circle cx="12" cy="12" r="2" fill="#FFFFFF" />
                        </svg>
                    </span>
                    <span class="admin-brand-name">Admin Panel</span>
                </a>
            </div>
        </asp:Panel>

        <%-- ================= SIDEBAR + TOPBAR SHELL (all other admin pages) ================= --%>
        <div id="adminLayout" runat="server" class="admin-layout admin-layout-sidebar">

            <%-- Left navigation sidebar --%>
            <asp:Panel ID="pnlSidebar" runat="server" CssClass="admin-sidebar">

                <div class="admin-side-profile">
                    <span class="admin-side-avatar">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="8.5" r="4" />
                            <path d="M4 20.5c1.4-4.2 4.4-6.5 8-6.5s6.6 2.3 8 6.5H4z" />
                        </svg>
                    </span>
                    <span class="admin-side-meta">
                        <span class="admin-side-name">Admin User</span>
                        <span class="admin-side-role">Admin Panel</span>
                    </span>
                </div>

                <nav class="admin-nav">
                    <a id="lnkNavDashboard" runat="server" class="admin-nav-item" href="~/Admin/AdminDashboard.aspx">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <rect x="3" y="3" width="8" height="8" rx="1.6" />
                            <rect x="13" y="3" width="8" height="8" rx="1.6" />
                            <rect x="3" y="13" width="8" height="8" rx="1.6" />
                            <rect x="13" y="13" width="8" height="8" rx="1.6" />
                        </svg>
                        Dashboard
                    </a>

                    <span id="navUsersItem" runat="server" class="admin-nav-item">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <circle cx="9" cy="8" r="3.5" />
                            <path d="M2.5 19c.8-3.2 3.3-5 6.5-5s5.7 1.8 6.5 5H2.5z" />
                            <circle cx="17" cy="8.6" r="2.7" />
                            <path d="M16.2 13.7c2.6.1 4.6 1.7 5.3 4.3h-4.1c-.3-1.6-.9-3-2-4.2.2-.1.5-.1.8-.1z" />
                        </svg>
                        <asp:LinkButton ID="lnkNavUsers" runat="server"
                            CssClass="admin-nav-label"
                            OnClick="lnkNavUsers_Click">Manage Users</asp:LinkButton>
                    </span>

                    <asp:LinkButton ID="lnkLogout" runat="server"
                        CssClass="admin-nav-item admin-nav-logout"
                        OnClick="lnkLogout_Click">Logout</asp:LinkButton>
                </nav>

            </asp:Panel>

            <%-- Right hand page area: top bar + content + footer --%>
            <div class="admin-page">

                <asp:Panel ID="pnlTopbar" runat="server" CssClass="admin-topbar">
                    <h1 class="admin-topbar-title">
                        <asp:Label ID="lblTopbarTitle" runat="server" Text="Admin Dashboard" />
                    </h1>
                    <div class="admin-topbar-right">
                        <span class="admin-topbar-welcome">Welcome,
                            <asp:Label ID="lblTopbarUser" runat="server" Text="System Administrator" /></span>
                        <span class="admin-side-avatar admin-topbar-avatar">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" aria-hidden="true">
                                <circle cx="12" cy="8.5" r="4" />
                                <path d="M4 20.5c1.4-4.2 4.4-6.5 8-6.5s6.6 2.3 8 6.5H4z" />
                            </svg>
                        </span>
                    </div>
                </asp:Panel>

                <%-- ======================= PAGE CONTENT ========================== --%>
                <main class="admin-main">
                    <asp:ContentPlaceHolder ID="AdminContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <%-- ============================ FOOTER =========================== --%>
                <footer class="admin-footer">
                    <p>&copy; <%: DateTime.Now.Year %> Admin Panel - Online Billing System. All rights reserved.</p>
                </footer>

            </div>
        </div>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
