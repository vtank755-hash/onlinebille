<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dashboard.master.cs" Inherits="vivektank1.DashboardMaster" %>

<%-- Dashboard shell master page: navy sidebar (user + navigation) and the
     white top bar (page title + welcome). Content pages such as
     Dashboard.aspx, BillEntry.aspx, ViewBills.aspx and Profile.aspx fill
     the DashContent placeholder. --%>
<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Online Billing System</title>
    <link href="~/Content/Billing.css" rel="stylesheet" type="text/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body class="dash-body">
    <form runat="server">

        <%-- Framework scripts: WebForms.js defines __doPostBack, which the
             AutoPostBack text boxes of Bill Entry (Qty / Rate) need, and
             WebUIValidation.js runs the validation controls on the client. --%>
        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <div class="dash-shell">

            <%-- ============================ SIDEBAR =========================== --%>
            <aside class="dash-side">

                <div class="dash-user">
                    <span class="dash-avatar">
                        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <circle cx="20" cy="20" r="20" fill="#DBE3FF" />
                            <circle cx="20" cy="15.5" r="6.6" fill="#5B6BD6" />
                            <path d="M6.5 36c2.6-7.2 8.3-11 13.5-11s10.9 3.8 13.5 11" fill="#5B6BD6" />
                        </svg>
                    </span>
                    <span class="dash-user-text">
                        <asp:Label ID="lblSideName" runat="server" CssClass="dash-user-name" Text="Amit Kumar" />
                        <span class="dash-user-role">B-Tech Student</span>
                    </span>
                </div>

                <nav class="dash-nav">
                    <asp:HyperLink ID="navDashboard" runat="server"
                        NavigateUrl="~/Dashboard.aspx"
                        CssClass="dash-nav-item is-active">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.6" /><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.6" /><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.6" /><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.6" /></svg>
                        </span>Dashboard</asp:HyperLink>

                    <asp:HyperLink ID="navBillEntry" runat="server"
                        NavigateUrl="~/BillEntry.aspx"
                        CssClass="dash-nav-item">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 3h7l4.5 4.5V21H7z" /><path d="M13.6 3v5h4.7" /><path d="M9.7 13.5h5" /><path d="M9.7 17h5" /></svg>
                        </span>Bill Entry</asp:HyperLink>

                    <asp:HyperLink ID="navCustomers" runat="server"
                        NavigateUrl="~/AddCustomer.aspx"
                        CssClass="dash-nav-item">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="8.8" cy="9" r="3.2" /><circle cx="16.2" cy="10" r="2.6" /><path d="M3 19.4c.9-3.1 3.1-4.7 5.8-4.7s4.9 1.6 5.8 4.7" /><path d="M15.4 14.9c2.3.2 3.9 1.7 4.6 4.2" /></svg>
                        </span>Customers</asp:HyperLink>

                    <asp:HyperLink ID="navViewBills" runat="server"
                        NavigateUrl="~/ViewBills.aspx"
                        CssClass="dash-nav-item">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M3.5 9.5h17" /><path d="M9 9.5v10" /></svg>
                        </span>View Bills</asp:HyperLink>

                    <asp:HyperLink ID="navProfile" runat="server"
                        NavigateUrl="~/Profile.aspx"
                        CssClass="dash-nav-item">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="12" cy="8.4" r="4" /><path d="M4.5 20.5c1.4-4.2 4.3-6.3 7.5-6.3s6.1 2.1 7.5 6.3" /></svg>
                        </span>Profile</asp:HyperLink>

                    <asp:LinkButton ID="lnkLogout" runat="server"
                        CssClass="dash-nav-item dash-nav-logout"
                        OnClick="lnkLogout_Click">
                        <span class="dash-nav-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 4.5H6.5v15H14" /><path d="M11.5 12h8.5" /><path d="M16.8 8.2 20.5 12l-3.7 3.8" /></svg>
                        </span>Logout</asp:LinkButton>
                </nav>

            </aside>

            <%-- ============================= MAIN ============================ --%>
            <div class="dash-col">

                <header class="dash-topbar">
                    <h1 class="dash-page-title">
                        <asp:ContentPlaceHolder ID="DashHeaderTitle" runat="server">Dashboard</asp:ContentPlaceHolder>
                    </h1>
                    <div class="dash-welcome">
                        <span class="dash-welcome-text"><asp:Label ID="lblWelcomePrefix" runat="server" Text="Welcome," />
                            <asp:Label ID="lblWelcomeName" runat="server" Text="Amit Kumar" /></span>
                        <span class="dash-avatar dash-avatar-sm">
                            <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <circle cx="20" cy="20" r="20" fill="#DBE3FF" />
                                <circle cx="20" cy="15.5" r="6.6" fill="#5B6BD6" />
                                <path d="M6.5 36c2.6-7.2 8.3-11 13.5-11s10.9 3.8 13.5 11" fill="#5B6BD6" />
                            </svg>
                        </span>
                    </div>
                </header>

                <main class="dash-main">
                    <asp:ContentPlaceHolder ID="DashContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

            </div>

        </div>

    </form>
</body>
</html>
